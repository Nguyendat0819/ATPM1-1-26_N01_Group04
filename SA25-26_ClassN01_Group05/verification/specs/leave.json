{
  "name": "leave",
  "title": "Duyệt đơn nghỉ phép",
  "implementation_source": "leave_service/routes/leaves.js",
  "states": [
    {"id": "NO_REQUEST", "labels": ["no_request"], "initial": true},
    {"id": "PENDING", "labels": ["pending", "valid_leave_request"]},
    {"id": "APPROVED", "labels": ["approved"]},
    {"id": "REJECTED", "labels": ["rejected"]}
  ],
  "transitions": [
    ["NO_REQUEST", "PENDING"],
    ["PENDING", "APPROVED"],
    ["PENDING", "REJECTED"],
    ["APPROVED", "NO_REQUEST"],
    ["REJECTED", "NO_REQUEST"]
  ],
  "properties": {
    "safety": {
      "id": "LV1",
      "forbidden_edge": ["NO_REQUEST", "APPROVED"],
      "allowed_predecessors": {"APPROVED": ["PENDING"], "REJECTED": ["PENDING"]},
      "formula": "forall s in S: (R(s, APPROVED) or R(s, REJECTED)) implies s == PENDING",
      "description": "Mỗi yêu cầu chỉ kết thúc bằng APPROVED hoặc REJECTED sau PENDING."
    },
    "liveness": {"id": "LV2", "starts": ["PENDING"], "target_labels": ["approved", "rejected"], "formula": "AF(approved OR rejected)", "description": "Đơn đang chờ cuối cùng được duyệt hoặc từ chối."}
  },
  "faulty_transition": ["NO_REQUEST", "APPROVED"]
}
