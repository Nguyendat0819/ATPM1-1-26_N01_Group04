  "properties": {
    "safety": {"id": "L1", "forbidden_edge": ["UNAUTHENTICATED", "AUTHENTICATED"], "formula": "AG(!bypass_authentication)", "description": "Không thể đăng nhập thành công nếu chưa xác thực thông tin hợp lệ."},
    "liveness": {"id": "L2", "starts": ["AUTHENTICATING_VALID"], "target_labels": ["authenticated"], "formula": "AF(authenticated)", "description": "Thông tin đăng nhập hợp lệ cuối cùng dẫn tới trạng thái đã xác thực."}
  },
  "faulty_transition": ["UNAUTHENTICATED", "AUTHENTICATED"]
}
